{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Module",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "console": "integratedTerminal",
            "args": ["app.main:app","--reload", "--log-config", "log_conf.yaml"]
        },
        {
            "name": "SSL Python: Module",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "console": "integratedTerminal",
            "args": ["app.main:app","--reload", "--log-config", "log_conf.yaml", "--ssl-keyfile", "config/tls/key.pem", "--ssl-certfile", "config/tls/cert.pem"]
        },
        {
            "name": "Python: Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
    ]
}